         <pdfaProperty:description>Year of standard</pdfaProperty:description>
        </rdf:li>
        <rdf:li rdf:parseType="Resource">
         <pdfaProperty:name>rev</pdfaProperty:name>
         <pdfaProperty:valueType>Integer</pdfaProperty:valueType>
